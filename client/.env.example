# Local development uses Vite's existing /api proxy.
VITE_API_BASE_URL=/api
# In Vercel set VITE_API_BASE_URL to your Render backend HTTPS origin.
# The central client accepts either the origin or the origin followed by /api.
# Demo login visibility comes from the backend /api/settings/public endpoint.
# VITE_DEMO_LOGIN is no longer needed; use Render ALLOW_DEMO_LOGIN and admin settings.
