# Copy values into your hosting platform's server environment, not the browser.
NODE_ENV=production
HOST=0.0.0.0
PORT=4000
MONGODB_URI=
JWT_SECRET=
CLIENT_URL=https://daksh-setu-five.vercel.app
PUBLIC_APP_URL=https://daksh-setu-five.vercel.app
# 1 for one trusted reverse proxy (Render); otherwise configure for your host.
TRUST_PROXY=1
SEED_DEMO=false
ALLOW_DEMO_LOGIN=false
# Required for live AI and private media; leave all Cloudinary fields empty only for manual fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
