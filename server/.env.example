PORT=4000
CLIENT_URL=http://127.0.0.1:5173,http://localhost:5173
PUBLIC_APP_URL=http://127.0.0.1:5173
# Optional system FFmpeg and FFprobe paths for six-frame video analysis. Restart after changing.
FFMPEG_PATH=
FFPROBE_PATH=
# Leave empty to use local MongoDB on port 27027. Set a URI to use Atlas instead.
MONGODB_URI=
# Required in production; minimum 32 characters. Local dev generates a session secret.
JWT_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Demo accounts are auto-seeded only outside production. For production seed explicitly.
SEED_DEMO=false
# Production proxy setting for Render's single reverse proxy.
TRUST_PROXY=0
# Production defaults to false regardless of existing demo records.
ALLOW_DEMO_LOGIN=false
# Optional one-time bootstrap command; keep these values server-side.
BOOTSTRAP_ROLE=
BOOTSTRAP_NAME=
BOOTSTRAP_EMAIL=
BOOTSTRAP_PHONE=
BOOTSTRAP_PASSWORD=
